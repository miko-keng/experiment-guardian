NODE_ENV=development
PORT=3001

DATABASE_PATH=./data/experiment-guardian.sqlite

# AWS Bedrock Configuration
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MAX_TOKENS=2048
BEDROCK_TIMEOUT_MS=30000
BEDROCK_TEMPERATURE=0
ALLOW_MOCK_AI=false

# Privacy & Transcripts
PERSIST_TRANSCRIPTS=true
MAX_TRANSCRIPT_CHARACTERS=50000

# Bee Integration (Disabled by default)
BEE_ENABLED=false
BEE_API_BASE_URL=
BEE_API_TOKEN=
BEE_CLI_PATH=bee
BEE_CLI_TIMEOUT_MS=30000

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Optional recorded-audio transcription
TRANSCRIBE_ENABLED=false
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_INPUT_BUCKET=
TRANSCRIBE_OUTPUT_BUCKET=
TRANSCRIBE_JOB_TIMEOUT_MS=120000
MAX_AUDIO_BYTES=25000000

# Read-only GitLab + MLflow evidence import. Keep tokens on the backend.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_TRAINING_CONFIG_PATH=experiment-guardian.json
# Standalone MLflow: https://mlflow.example.com
# GitLab tracking: https://gitlab.com/api/v4/projects/PROJECT_ID/ml/mlflow
MLFLOW_TRACKING_URL=
MLFLOW_TOKEN=
# Required when MLFLOW_TRACKING_URL or either connector token is set.
APP_ACCESS_PASSWORD=
