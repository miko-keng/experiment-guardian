{
  "name": "experiment-guardian-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && mkdir -p dist/database/migrations && cp src/database/migrations/*.sql dist/database/migrations/",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
